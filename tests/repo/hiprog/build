# Link against a stub with the same soname; the real one is the hi package.
printf 'const char *hi(void) { return ""; }\n' > stub.c
cc -shared -fPIC -Wl,-soname,libhi.so.1 -o libhi.so stub.c
printf '#include <stdio.h>\nconst char *hi(void);\nint main(void) { puts(hi()); return 0; }\n' > main.c
cc -o hiprog main.c -L. -lhi
install -Dm755 hiprog "$DESTDIR/usr/bin/hiprog"
